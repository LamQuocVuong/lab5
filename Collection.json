      "name": "Positive_Cases",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains user ID\", function () {\r",
                  "    const data = pm.response.json();\r",
                  "\r",
                  "    pm.expect(data).to.have.property(\"id\");\r",
                  "    pm.environment.set(\"userId\", data.id);\r",
                  "\r",
                  "    console.log(\"Created user ID:\", data.id);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Nguyen Van An\",\r\n  \"gender\": \"male\",\r\n  \"email\": \"binhlab052026@example.com\",\r\n  \"status\": \"active\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
